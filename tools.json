{
  "brew": {
    "os": ["mac"],
    "check": "brew",
    "install": {
      "mac": "/bin/bash -c \"$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\""
    }
  },
  "curl": {
    "os": ["linux"],
    "install": { "linux": "sudo apt-get install -y curl" }
  },
  "git": {
    "os": ["mac", "linux"],
    "install": { "mac": "brew install git", "linux": "sudo apt-get install -y git" },
    "link": { ".gitconfig": "~/.gitconfig" }
  },
  "zsh": {
    "os": ["mac", "linux"],
    "install": { "mac": "brew install zsh", "linux": "sudo apt-get install -y zsh" },
    "link": { ".config/.zshrc": "~/.zshrc" }
  },
  "oh-my-zsh": {
    "os": ["mac", "linux"],
    "check": "~/.oh-my-zsh",
    "install": {
      "mac": "RUNZSH=no CHSH=no sh -c \"$(curl -fsSL https://raw.github.com/ohmyzsh/ohmyzsh/master/tools/install.sh)\"",
      "linux": "RUNZSH=no CHSH=no sh -c \"$(curl -fsSL https://raw.github.com/ohmyzsh/ohmyzsh/master/tools/install.sh)\""
    }
  },
  "fzf": {
    "os": ["mac", "linux"],
    "install": { "mac": "brew install fzf", "linux": "sudo apt-get install -y fzf" }
  },
  "nvim": {
    "os": ["mac", "linux"],
    "install": { "mac": "brew install neovim", "linux": "sudo apt-get install -y neovim" },
    "link": { ".config/nvim": "~/.config/nvim" }
  },
  "tmux": {
    "os": ["mac", "linux"],
    "install": { "mac": "brew install tmux", "linux": "sudo apt-get install -y tmux" },
    "link": { ".config/tmux": "~/.config/tmux" }
  },
  "nvm": {
    "os": ["mac", "linux"],
    "check": "~/.nvm",
    "install": {
      "mac": "curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/HEAD/install.sh | bash",
      "linux": "curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/HEAD/install.sh | bash"
    }
  },
  "agy": {
    "os": ["mac", "linux"],
    "install": {
      "mac": "curl -fsSL https://antigravity.google/cli/install.sh | bash",
      "linux": "curl -fsSL https://antigravity.google/cli/install.sh | bash"
    }
  },
  "wezterm": {
    "os": ["mac", "windows"],
    "install": { "mac": "brew install --cask wezterm", "windows": "winget install wezterm" },
    "link": { ".config/wezterm/wezterm.lua": "~/.config/wezterm/wezterm.lua" }
  },
  "lazygit": {
    "os": ["mac", "linux"],
    "install": { "mac": "brew install lazygit" },
    "link": {
      ".config/lazygit/config.yml": {
        "mac": "~/Library/Application Support/lazygit/config.yml",
        "linux": "~/.config/lazygit/config.yml"
      },
      ".config/lazygit/ai-commit.sh": {
        "mac": "~/Library/Application Support/lazygit/ai-commit.sh",
        "linux": "~/.config/lazygit/ai-commit.sh"
      }
    }
  },
  "herdr": {
    "os": ["mac", "linux"],
    "install": { "mac": "brew install herdr" },
    "link": { ".config/herdr/config.toml": "~/.config/herdr/config.toml" }
  },
  "im-select": {
    "os": ["mac"],
    "install": { "mac": "brew tap daipeihust/tap && brew install im-select" }
  },
  "nerd-font": {
    "os": ["mac", "windows"],
    "check": {
      "mac": "brew list --cask font-jetbrains-mono-nerd-font",
      "windows": "winget list DEVCOM.JetBrainsMonoNerdFont"
    },
    "install": {
      "mac": "brew install --cask font-jetbrains-mono-nerd-font",
      "windows": "winget install --id DEVCOM.JetBrainsMonoNerdFont"
    }
  },
  "gh": {
    "os": ["mac", "linux"],
    "install": { "mac": "brew install gh", "linux": "sudo apt-get install -y gh" },
    "link": { ".config/gh/config.yml": "~/.config/gh/config.yml" }
  },
  "agents": {
    "os": ["mac", "linux"],
    "link": { ".agents": "~/.agents" }
  }
}
