{
  "brew": {
    "os": ["mac"],
    "check": "brew",
    "install": {
      "mac": "/bin/bash -c \"$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\""
    }
  },
  "curl": {
    "os": ["linux"],
    "install": { "linux": "sudo apt-get install -y curl" }
  },
  "git": {
    "os": ["mac", "linux", "windows"],
    "install": {
      "mac": "brew install git",
      "linux": "sudo apt-get install -y git",
      "windows": "winget install --id Git.Git -e --source winget"
    },
    "link": { ".gitconfig": "~/.gitconfig" }
  },
  "zsh": {
    "os": ["mac", "linux"],
    "install": { "mac": "brew install zsh", "linux": "sudo apt-get install -y zsh" },
    "link": { ".config/.zshrc": "~/.zshrc" }
  },
  "oh-my-zsh": {
    "os": ["mac", "linux"],
    "check": "~/.oh-my-zsh",
    "install": {
      "mac": "RUNZSH=no CHSH=no sh -c \"$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)\"",
      "linux": "RUNZSH=no CHSH=no sh -c \"$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)\""
    }
  },
  "fzf": {
    "os": ["mac", "linux", "windows"],
    "install": {
      "mac": "brew install fzf",
      "linux": "sudo apt-get install -y fzf",
      "windows": "winget install --id junegunn.fzf -e --source winget"
    }
  },
  "ripgrep": {
    "os": ["mac", "linux", "windows"],
    "check": "rg",
    "install": {
      "mac": "brew install ripgrep",
      "linux": "sudo apt-get install -y ripgrep",
      "windows": "winget install --id BurntSushi.ripgrep.MSVC -e --source winget"
    }
  },
  "nvim": {
    "os": ["mac", "linux", "windows"],
    "install": {
      "mac": "brew install neovim",
      "linux": "sudo apt-get install -y neovim",
      "windows": "winget install --id Neovim.Neovim -e --source winget"
    },
    "link": {
      ".config/nvim": {
        "mac": "~/.config/nvim",
        "linux": "~/.config/nvim",
        "windows": "~/AppData/Local/nvim"
      }
    }
  },
  "nvm": {
    "os": ["mac", "linux", "windows"],
    "check": {
      "mac": "~/.nvm",
      "linux": "~/.nvm",
      "windows": "nvm"
    },
    "install": {
      "mac": "curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/HEAD/install.sh | bash && export NVM_DIR=\"$HOME/.nvm\" && [ -s \"$NVM_DIR/nvm.sh\" ] && \\. \"$NVM_DIR/nvm.sh\" && nvm install --lts",
      "linux": "curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/HEAD/install.sh | bash && export NVM_DIR=\"$HOME/.nvm\" && [ -s \"$NVM_DIR/nvm.sh\" ] && \\. \"$NVM_DIR/nvm.sh\" && nvm install --lts",
      "windows": "winget install --id CoreyButler.NVMforWindows -e --source winget"
    }
  },
  "node": {
    "os": ["mac", "linux", "windows"],
    "check": "node",
    "install": {
      "mac": "export NVM_DIR=\"$HOME/.nvm\" && [ -s \"$NVM_DIR/nvm.sh\" ] && \\. \"$NVM_DIR/nvm.sh\" && nvm install --lts",
      "linux": "export NVM_DIR=\"$HOME/.nvm\" && [ -s \"$NVM_DIR/nvm.sh\" ] && \\. \"$NVM_DIR/nvm.sh\" && nvm install --lts",
      "windows": "nvm install lts && nvm use lts"
    }
  },
  "pnpm": {
    "os": ["mac", "linux", "windows"],
    "install": {
      "mac": "corepack enable pnpm",
      "linux": "corepack enable pnpm",
      "windows": "winget install --id pnpm.pnpm -e --source winget"
    }
  },
  "uv": {
    "os": ["mac", "linux", "windows"],
    "check": "uv",
    "install": {
      "mac": "brew install uv",
      "linux": "curl -LsSf https://astral.sh/uv/install.sh | sh",
      "windows": "winget install --id astral-sh.uv -e --source winget"
    }
  },
  "agy": {
    "os": ["mac", "linux"],
    "install": {
      "mac": "curl -fsSL https://antigravity.google/cli/install.sh | bash",
      "linux": "curl -fsSL https://antigravity.google/cli/install.sh | bash"
    }
  },
  "github-copilot-cli": {
    "os": ["mac", "linux", "windows"],
    "check": "github-copilot-cli",
    "install": {
      "mac": "pnpm add -g @githubnext/github-copilot-cli",
      "linux": "pnpm add -g @githubnext/github-copilot-cli",
      "windows": "pnpm add -g @githubnext/github-copilot-cli"
    }
  },
  "wezterm": {
    "os": ["mac", "windows"],
    "install": { "mac": "brew install --cask wezterm", "windows": "winget install --id wez.wezterm -e --source winget" },
    "link": { ".config/wezterm/wezterm.lua": "~/.config/wezterm/wezterm.lua" }
  },
  "lazygit": {
    "os": ["mac", "linux", "windows"],
    "install": {
      "mac": "brew install lazygit",
      "windows": "winget install --id JesseDuffield.lazygit -e --source winget"
    },
    "link": {
      ".config/lazygit/config.yml": {
        "mac": "~/Library/Application Support/lazygit/config.yml",
        "linux": "~/.config/lazygit/config.yml",
        "windows": "~/AppData/Local/lazygit/config.yml"
      },
      ".config/lazygit/ai-commit.sh": {
        "mac": "~/Library/Application Support/lazygit/ai-commit.sh",
        "linux": "~/.config/lazygit/ai-commit.sh"
      },
      ".config/lazygit/ai.conf": {
        "mac": "~/Library/Application Support/lazygit/ai.conf",
        "linux": "~/.config/lazygit/ai.conf",
        "windows": "~/AppData/Local/lazygit/ai.conf"
      }
    }
  },
  "herdr": {
    "os": ["mac", "linux"],
    "install": { "mac": "brew install herdr" },
    "link": { ".config/herdr/config.toml": "~/.config/herdr/config.toml" }
  },
  "im-select": {
    "os": ["mac"],
    "install": { "mac": "brew tap daipeihust/tap && brew install im-select" }
  },
  "zenhan": {
    "os": ["windows"],
    "check": "zenhan",
    "install": {
      "windows": "powershell -Command \"Invoke-WebRequest -Uri https://github.com/iuchim/zenhan/releases/download/v0.0.1/zenhan.zip -OutFile $env:TEMP\\zenhan.zip; Expand-Archive -Path $env:TEMP\\zenhan.zip -DestinationPath $env:LOCALAPPDATA\\zenhan -Force; [Environment]::SetEnvironmentVariable('Path', [Environment]::GetEnvironmentVariable('Path', 'User') + ';' + $env:LOCALAPPDATA + '\\zenhan', 'User')\""
    }
  },
  "nerd-font": {
    "os": ["mac", "windows"],
    "check": {
      "mac": "brew list --cask font-jetbrains-mono-nerd-font",
      "windows": "winget list DEVCOM.JetBrainsMonoNerdFont"
    },
    "install": {
      "mac": "brew install --cask font-jetbrains-mono-nerd-font",
      "windows": "winget install --id DEVCOM.JetBrainsMonoNerdFont"
    }
  },
  "gh": {
    "os": ["mac", "linux", "windows"],
    "install": {
      "mac": "brew install gh",
      "linux": "sudo apt-get install -y gh",
      "windows": "winget install --id GitHub.cli -e --source winget"
    },
    "link": {
      ".config/gh/config.yml": {
        "mac": "~/.config/gh/config.yml",
        "linux": "~/.config/gh/config.yml",
        "windows": "~/AppData/Roaming/GitHub CLI/config.yml"
      }
    }
  },
  "agents": {
    "os": ["mac", "linux", "windows"],
    "link": { ".agents": "~/.agents" }
  }
}
