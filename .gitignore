##################################
# 機密情報（絶対にコミットしない）
##################################
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.netrc
.credentials
secrets/
private/

# SSH / GPG（公開鍵 *.pub は必要ならコミット可）
id_rsa
id_ed25519
id_ecdsa
id_dsa
*.asc
!*.pub

##################################
# Neovim: キャッシュ・状態・生成物
##################################
.cache/
.local/state/nvim/
.local/share/nvim/
.nvim/
nvim.log
*.spell

# lazy-lock.json は再現性のためコミットする（無視しない）

##################################
# Vim / エディタ
##################################
*.swp
*.swo
*~
*.bak
Session.vim
.netrwhist
tags
TAGS
.ccls-cache/

##################################
