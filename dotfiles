#!/usr/bin/env python3
import argparse
import datetime
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

def detect_os():
    if sys.platform == "darwin":
        return "mac"
    if sys.platform.startswith("linux"):
        return "linux"
    if sys.platform in ("win32", "cygwin", "msys"):
        return "windows"
    return "unknown"

def refresh_path():
    """Windows環境でレジストリから最新の環境変数(特にPATH)を即時反映する"""
    if sys.platform in ("win32", "cygwin", "msys"):
        try:
            import winreg
            reg_targets = [
                (winreg.HKEY_LOCAL_MACHINE, r"SYSTEM\CurrentControlSet\Control\Session Manager\Environment"),
                (winreg.HKEY_CURRENT_USER, r"Environment"),
            ]
            # 1. NVM_HOME 等の変数を先に os.environ に取り込む
            for hkey, sub in reg_targets:
                try:
                    with winreg.OpenKey(hkey, sub) as k:
                        for i in range(winreg.QueryInfoKey(k)[1]):
                            name, val, _ = winreg.EnumValue(k, i)
                            if name.upper() != "PATH":
                                os.environ[name] = os.path.expandvars(str(val))
                except Exception:
                    pass

            # 2. PATH を取得して環境変数を展開
            parts = []
            for hkey, sub in reg_targets:
                try:
                    with winreg.OpenKey(hkey, sub) as k:
                        val, _ = winreg.QueryValueEx(k, "Path")
                        parts.append(val)
                except Exception:
                    pass
            if parts:
                new_path = os.path.expandvars(";".join(parts))
                existing_parts = os.environ.get("PATH", "").split(";")
                merged = [p for p in new_path.split(";") if p]
                for p in existing_parts:
                    if p and p not in merged:
                        merged.append(p)
                os.environ["PATH"] = ";".join(merged)
        except Exception:
            pass

def is_installed(name: str, conf: dict, target_os: str) -> bool:
    refresh_path()
    check = conf.get("check")
    if isinstance(check, dict):
        check = check.get(target_os)
    if not check:
        check = name

    # 1. ファイル/ディレクトリパス (例: ~/.nvm, ~/.oh-my-zsh)
    if "/" in check or "~" in check:
        return Path(os.path.expanduser(check)).exists()

    # 2. コマンドライン実行による判定 (例: brew list ...)
    if " " in check:
        ret = subprocess.run(check, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return ret.returncode == 0

    # 3. 単一コマンド名 (PATH検索)
    return shutil.which(check) is not None

def link(src: Path, dest: Path, dry_run: bool):
    dest = Path(os.path.expanduser(str(dest)))
    src = src.resolve()

    if not src.exists():
        return

    if os.path.islink(dest):
        try:
            target = Path(os.readlink(dest)).expanduser()
            if not target.is_absolute():
                target = (dest.parent / target).resolve()
            else:
                target = target.resolve()
            if target == src:
                print(f"  [OK]   既にリンク済み: {dest.name}")
                return
        except Exception:
            pass

    if dry_run:
        print(f"  (dry)  link: {dest} -> {src}")
        return

    dest.parent.mkdir(parents=True, exist_ok=True)
    if os.path.islink(dest):
        dest.unlink()
    elif dest.exists():
        bak = dest.with_name(f"{dest.name}.bak.{datetime.datetime.now().strftime('%Y%m%d%H%M%S')}")
        print(f"  [BAK]  バックアップ: {bak.name}")
        dest.rename(bak)

    dest.symlink_to(src, target_is_directory=src.is_dir())
    print(f"  [LINK] {dest} -> {src}")

def restore(dest: Path, dry_run: bool):
    dest = Path(os.path.expanduser(str(dest)))
    parent = dest.parent
    if not parent.exists():
        return

    patterns = [f"{dest.name}.bak.*", f"{dest.name}.backup.*"]
    backups = []
    for pat in patterns:
        backups.extend(parent.glob(pat))

    if not backups:
        return

    latest_bak = sorted(backups)[-1]

    if dry_run:
        print(f"  (dry)  restore: {dest} <- {latest_bak.name}")
        return

    if os.path.islink(dest):
        dest.unlink()
    elif dest.exists():
        old = dest.with_name(f"{dest.name}.old.{datetime.datetime.now().strftime('%Y%m%d%H%M%S')}")
        dest.rename(old)

    latest_bak.rename(dest)
    print(f"  [RESTORE] {dest} <- {latest_bak.name}")

def sync_skills(dry_run: bool):
    refresh_path()
    if not shutil.which("npx"):
        print("  [SKIP] npx が見つからないためスキル同期をスキップしました (Node.js インストール後に同期されます)")
        return

    lock_file = Path(os.path.expanduser("~/.agents/.skill-lock.json"))
    if not lock_file.exists():
        return
    try:
        with open(lock_file, "r", encoding="utf-8") as f:
            data = json.load(f)
        skills = data.get("skills", {})
        sources = {info["source"] for info in skills.values() if "source" in info}
        for source in sorted(sources):
            cmd = f"npx -y skills add {source} -g -y"
            if dry_run:
                print(f"  (dry)  skill sync: {cmd}")
            else:
                print(f"  [SKILL] {source}")
                subprocess.run(cmd, shell=True)
    except Exception as e:
        print(f"  [WARN] スキル同期中にエラーが発生しました: {e}", file=sys.stderr)

def main():
    parser = argparse.ArgumentParser(description="Simple dotfiles & tool manager")
    parser.add_argument("os", nargs="?", help="対象OS (mac, windows, linux) または 'restore'")
    parser.add_argument("target_os_extra", nargs="?", choices=["mac", "windows", "linux"], help="restore 実行時の対象OS (省略時は自動検出)")
    parser.add_argument("-r", "--restore", action="store_true", help="バックアップから元の設定を復元")
    parser.add_argument("-c", "--config-only", action="store_true", help="リンク反映のみ")
    parser.add_argument("-n", "--dry-run", action="store_true", help="プレビュー")
    args = parser.parse_args()

    dotfiles_dir = Path(__file__).resolve().parent
    config_file = dotfiles_dir / "tools.json"

    if not config_file.exists():
        print(f"Error: {config_file} not found", file=sys.stderr)
        sys.exit(1)

    is_restore = args.restore or (args.os == "restore")
    if args.os == "restore":
        target_os = args.target_os_extra or detect_os()
    else:
        target_os = args.os or detect_os()

    if target_os not in ("mac", "windows", "linux"):
        print(f"Error: 不明なOSです: {target_os} (mac, windows, linux のいずれかを指定してください)", file=sys.stderr)
        sys.exit(1)

    refresh_path()

    with open(config_file, "r", encoding="utf-8") as f:
        tools = json.load(f)

    # 復元モード
    if is_restore:
        print(f"==> RESTORE Mode: {target_os.upper()}\n")
        restored_count = 0
        for name, conf in tools.items():
            if target_os not in conf.get("os", []):
                continue
            for src_rel, dest_val in conf.get("link", {}).items():
                dest_str = dest_val.get(target_os) if isinstance(dest_val, dict) else dest_val
                if dest_str:
                    restore(Path(dest_str), args.dry_run)
                    restored_count += 1
        print("\n==> Restore complete!")
        return

    # 通常セットアップモード
    print(f"==> Target OS: {target_os.upper()}\n")

    for name, conf in tools.items():
        if target_os not in conf.get("os", []):
            continue

        print(f"[{name}]")

        # 1. Install
        if not args.config_only and "install" in conf:
            cmd = conf["install"].get(target_os)
            if cmd:
                if is_installed(name, conf, target_os):
                    print(f"  [OK]   インストール済み ({name})")
                else:
                    print(f"  [RUN]  {cmd}")
                    if not args.dry_run:
                        subprocess.run(cmd, shell=True)
                        refresh_path()

        # 2. Symlinks
        for src_rel, dest_val in conf.get("link", {}).items():
            dest_str = dest_val.get(target_os) if isinstance(dest_val, dict) else dest_val
            if dest_str:
                link(dotfiles_dir / src_rel, Path(dest_str), args.dry_run)

        # 3. Agents スキル同期 (.skill-lock.json から全エージェントへインストール)
        if name == "agents" and not args.config_only:
            sync_skills(args.dry_run)

    print("\n==> Done!")

if __name__ == "__main__":
    main()
