#!/usr/bin/env python3
import os
import shutil
import subprocess
import sys
from pathlib import Path
def main():
    # 1. 引数解析とモデル一覧オプション
    import argparse
    parser = argparse.ArgumentParser(description="Generate AI commit message for lazygit")
    parser.add_argument("-p", "--provider", help="AI provider (agy, copilot, gh)")
    parser.add_argument("-m", "--model", help="AI model name")
    parser.add_argument("--models", "--list-models", action="store_true", help="List available models")
    args, _ = parser.parse_known_args()

    if args.models:
        if shutil.which("agy"):
            print("=== agy models ===")
            subprocess.run(["agy", "models"])
        else:
            print("agy command not found.")
        sys.exit(0)

    # 2. Staged の差分を取得
    try:
        diff = subprocess.check_output(["git", "diff", "--cached"], text=True)
    except Exception:
        print("Error: Not a git repository or git command failed.", file=sys.stderr)
        sys.exit(1)

    if not diff.strip():
        print("Staged changes not found. Please stage files before running AI commit.")
        sys.exit(1)

    # 3. 設定の読み込み (優先度: CLI引数 > 環境変数 > git config > ai.conf)
    provider = args.provider or os.environ.get("LAZYGIT_AI_PROVIDER") or os.environ.get("LAZYGIT_AI")
    model = args.model or os.environ.get("LAZYGIT_AI_MODEL")

    if not provider:
        try:
            val = subprocess.check_output(["git", "config", "--get", "ai.provider"], text=True).strip()
            if val:
                provider = val
        except Exception:
            pass

    if not model:
        try:
            val = subprocess.check_output(["git", "config", "--get", "ai.model"], text=True).strip()
            if val:
                model = val
        except Exception:
            pass

    if not provider or not model:
        candidates = [
            Path.home() / ".config/lazygit/ai.conf",
            Path.home() / "Library/Application Support/lazygit/ai.conf",
            Path.home() / "AppData/Local/lazygit/ai.conf",
            Path(__file__).resolve().parent / "ai.conf",
        ]
        for conf in candidates:
            if conf.exists():
                with open(conf, "r", encoding="utf-8") as f:
                    for line in f:
                        line = line.strip()
                        if not line or line.startswith("#"):
                            continue
                        if "=" in line:
                            k, v = line.split("=", 1)
                            key = k.strip().upper()
                            val = v.strip().strip("\"'")
                            if key in ("AI_PROVIDER", "PROVIDER") and not provider:
                                provider = val
                            elif key in ("AI_MODEL", "MODEL") and not model:
                                model = val
                        else:
                            if not provider:
                                provider = line
                if provider:
                    break

    # プロバイダが未指定または見つからない場合の自動フォールバック
    if provider == "agy" and not shutil.which("agy"):
        if shutil.which("copilot") or shutil.which("gh"):
            provider = "copilot"
    elif not provider:
        provider = "agy" if shutil.which("agy") else "copilot"

    # デフォルトモデル (agy の場合は高速な gemini-3.8-flash-low を推奨デフォルトに)
    if not model and provider == "agy":
        model = "gemini-3.8-flash-low"

    model_display = f" ({model})" if model else ""
    print(f"Generating commit message with AI [{provider}{model_display}]...")

    prompt = f"""Generate a Git commit message based on the following diff.
Follow this EXACT format:
<prefix>: <short english description>
- <日本語での変更点1>
- <日本語での変更点2>
- ...

Rules:
- Prefix must be one of: add, update, feat, fix, chore, docs, style, refactor, perf, test
- The first line must be in English and concise.
- Do NOT leave a blank line after the first line.
- The details must be written in Japanese using a bulleted list (- ).
- Output ONLY the commit message, no markdown code blocks, no intro, no outro.

Diff:
{diff}"""

    is_win = sys.platform in ("win32", "cygwin", "msys")

    # 3. AI ツール呼び出し
    output = ""
    if provider == "agy":
        cmd = ["agy", "--disable-slash-commands"]
        if model:
            cmd.extend(["--model", model])
        cmd.extend(["-p", prompt])
        res = subprocess.run(cmd, capture_output=True, text=True, shell=is_win)
        if res.returncode != 0:
            print(f"Error running agy: {res.stderr}", file=sys.stderr)
            sys.exit(1)
        output = res.stdout.strip()
    elif provider in ("copilot", "gh", "gh-copilot"):
        if shutil.which("copilot"):
            cmd = ["copilot", "-s"]
            if model:
                cmd.extend(["--model", model])
            cmd.extend(["-p", prompt])
            res = subprocess.run(cmd, capture_output=True, text=True, shell=is_win)
            if res.returncode != 0:
                print(f"Error running copilot: {res.stderr}", file=sys.stderr)
                sys.exit(1)
            output = res.stdout.strip()
        elif shutil.which("gh"):
            cmd = ["gh", "copilot"]
            if model:
                cmd.extend(["--model", model])
            cmd.extend(["-p", prompt])
            res = subprocess.run(cmd, capture_output=True, text=True, shell=is_win)
            if res.returncode != 0:
                print(f"Error running gh copilot: {res.stderr}", file=sys.stderr)
                sys.exit(1)
            output = res.stdout.strip()
        else:
            print("Error: copilot or gh command not found.", file=sys.stderr)
            sys.exit(1)
    else:
        print(f"Error: Unknown AI provider '{provider}'. Supported: agy, copilot", file=sys.stderr)
        sys.exit(1)

    # 4. .git/COMMIT_EDITMSG に書き込み
    commit_editmsg = Path(".git/COMMIT_EDITMSG")
    commit_editmsg.write_text(output + "\n", encoding="utf-8")

    # 5. クリップボードにコピー
    copied = False
    for clip_cmd in ["pbcopy", "wl-copy", "xclip"]:
        if shutil.which(clip_cmd):
            try:
                subprocess.run([clip_cmd], input=output, text=True, check=True)
                copied = True
                break
            except Exception:
                pass

    if not copied and is_win:
        try:
            subprocess.run(["powershell", "-NoProfile", "-Command", "$input | Set-Clipboard"], input=output, text=True, check=True)
            copied = True
        except Exception:
            if shutil.which("clip.exe"):
                try:
                    subprocess.run(["clip.exe"], input=output, text=True)
                    copied = True
                except Exception:
                    pass

    # 6. 結果出力
    print(output)

if __name__ == "__main__":
    main()
